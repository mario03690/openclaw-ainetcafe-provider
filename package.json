{
  "name": "openclaw-ainetcafe-provider",
  "version": "0.1.1",
  "description": "OpenClaw provider plugin for ainetcafe (Kimi K3 at native MXFP4, OpenAI-compatible, https://microquickjs.com/v1).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mario03690/openclaw-ainetcafe-provider"
  },
  "homepage": "https://ainetcafe.com/k3/guides/openclaw.html",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "kimi",
    "kimi-k3",
    "ainetcafe",
    "provider"
  ],
  "files": [
    "index.js",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4"
    },
    "providers": [
      "ainetcafe"
    ]
  }
}
